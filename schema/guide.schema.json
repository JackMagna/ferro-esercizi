{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/JackMagna/ferro-esercizi@main/schema/guide.schema.json",
  "title": "Scheda di un esercizio (ferro-esercizi)",
  "type": "object",
  "required": ["id", "name", "aliases", "libraryIds", "kind", "muscles", "setup", "steps", "mistakes", "cue", "feel", "stop", "sources", "reviewedBy"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Uguale al nome del file, senza .json" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "description": "Altri nomi usati nelle schede dei coach" },
    "libraryIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "id di free-exercise-db" },
    "kind": { "enum": ["macchina", "cavi", "pesi liberi", "corpo libero"] },
    "muscles": { "type": "string", "minLength": 1 },
    "setup": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "description": "Regolazioni o posizione di partenza" },
    "steps": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "mistakes": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "required": ["error", "fix"], "additionalProperties": false,
        "properties": { "error": { "type": "string", "minLength": 1 }, "fix": { "type": "string", "minLength": 1 } }
      }
    },
    "cue": { "type": "string", "minLength": 1, "description": "Frase breve da ricordare durante la serie" },
    "feel": { "type": "string", "minLength": 1 },
    "stop": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Chiavi di sources.json" },
    "reviewedBy": { "type": ["string", "null"], "description": "Chi ha controllato la scheda (coach, fisioterapista), oppure null" }
  }
}
